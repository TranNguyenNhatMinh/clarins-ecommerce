# Port server
PORT=5000

# MongoDB - dùng connection string từ MongoDB Atlas hoặc local
# Local: mongodb://localhost:27017/product_management
# Atlas: mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/product_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/product_management

# JWT Secret - nên dùng chuỗi dài, ngẫu nhiên trong production
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Token expiry (ví dụ: 7d = 7 ngày)
JWT_EXPIRE=7d

# Frontend URL (CORS) - production: https://your-frontend.com
FRONTEND_URL=http://localhost:5173
